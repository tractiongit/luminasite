ponentsLoader"],"siteFeaturesConfigs":null},"props":{"render":{"compProps":{"comp-ki4spjqr":{"skin":"TextOnlyMenuButtonSkin","items":[{"label":"Home","link":{"href":"https://www.larafavrin.com","target":"_self","type":"PageLink","id":"1fti"},"id":"bmi23nr"},{"label":"Procedimentos","link":{"href":"https://www.larafavrin.com/procedimentos","target":"_self","type":"PageLink","id":"dataItem-khv62jhk1"},"id":"dataItem-khv62jhk"},{"label":"Blog","link":{"href":"https://www.larafavrin.com/blog","target":"_self","type":"PageLink","id":"dataItem-l7kugji11"},"id":"dataItem-l7kugji1"}],"skinExports":{"menuBorderY":0,"menuBtnBorder":0,"ribbonEls":0,"labelPad":0,"ribbonExtra":0},"alignButtons":"center","moreItemHeight":15,"moreButtonLabel":"More","rtl":false,"sameWidthButtons":false,"marginAllChildren":true,"stretchButtonsToMenuWidth":true,"isTouchDevice":false,"renderSEOSubItems":true,"isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.menus.DropDownMenu","translations":{"subMenuIndication":"Use tab to navigate through the menu items.","ariaLabel":"Site","dropdownButtonAriaLabel":"More <%= itemName %> pages"}},"comp-l7ksjxr3":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:rgb(199, 199, 199); font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Invisalign</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7ksjxrg":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">&Eacute; um <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">aparelho</span> totalmente <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">transparente e remov&iacute;vel</span> que permite a corre&ccedil;&atilde;o dos dentes de maneira muito mais confort&aacute;vel, segura, previs&iacute;vel e discreta. </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">&Eacute; o que temos de mais moderno.</span></span></span><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">&nbsp;</span>Atrav&eacute;s de um escaneamento, conseguimos fazer um plano de tratamento e apresentar ao paciente o resultado final antes mesmo de come&ccedil;ar.&nbsp;</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt0bw4":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex, serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Clareamento</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt0bwa":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Ideal para quem quer dar uma <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">iluminada no sorriso</span> sem perder a naturalidade. Podemos fazer no consult&oacute;rio, normalmente 2 ou 3 sess&otilde;es, confeccionar uma placa, aplicar o produto e fazer em casa ou fazer os dois, afim de obter melhores resultados.&nbsp;</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7ksmsdu1":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:rgb(199, 199, 199); font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Endodontia</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7ksxgpv":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Conhecido tamb&eacute;m como <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">tratamento de canal</span>, esse procedimento visa a remo&ccedil;&atilde;o de um ou mais canais presentes no dente. </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Essa remo&ccedil;&atilde;o pode acontecer por alguns motivos e os principais s&atilde;o: <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">inflama&ccedil;&atilde;o ou infec&ccedil;&atilde;o do dente</span>.&nbsp;</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt0uk8":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex, serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Implantes</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt0uke":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Trata-se de um dispositivo de titanio ou zirconia, que &eacute; <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">inserido no osso</span> a fim de substituir a ra&iacute;z do dente perdido, promovendo a <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">reabilita&ccedil;&atilde;o funcional e est&eacute;tica</span> de maneira <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">fixa</span>.&nbsp;</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kstnyz2":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:rgb(199, 199, 199); font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Pr&oacute;tese Fixa</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kstnz03":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Tamb&eacute;m conhecida como coroa e popularmente como <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">&quot;jaqueta&quot;</span>, &eacute; um tratamento reabilitador que substitui um dente danificado. </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Pode ser feito com diversos materiais, sendo os mais comuns <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">resina e porcelana</span>.</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kszsrj2":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Pr&oacute;tese Remov&iacute;vel</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kszsrl2":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Usada para <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">substituir os dentes</span>, de maneira remov&iacute;vel. Pode ser parcial ou total, dependendo do quadro cl&iacute;nico de cada paciente. Ela pode ser retira e encaixada sempre que necess&aacute;rio.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt37s4":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:rgb(199, 199, 199); font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Placa de Bruxismo</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt37s71":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif; font-size:18px;\" class=\"wixui-rich-text__text\">Existem v&aacute;rias maneiras de <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">aliviar os efeitos</span> do bruxismo. Uma delas &eacute; a placa de bruxismo ou placa miorelaxante. </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif; font-size:18px;\" class=\"wixui-rich-text__text\">Trata-se de um dispositivo <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">usado principalmente durante o sono</span>, que protege os dentes dos desgastes causados pela fric&ccedil;&atilde;o entre eles.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt5arx":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Restaura&ccedil;&atilde;o</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt5as02":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:center; font-size:15px;\"><span style=\"color:rgb(255, 255, 255); font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif; font-size:18px;\" class=\"wixui-rich-text__text\">&Eacute; a <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">reconstru&ccedil;&atilde;o</span> da parte destru&iacute;da de um dente. </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:center; font-size:15px;\"><span style=\"color:rgb(255, 255, 255); font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Essa destrui&ccedil;&atilde;o pode ocorrer por diversos motivos, de v&aacute;rias formas e com extens&otilde;es variadas. Os motivos mais comuns dessas destrui&ccedil;&otilde;es s&atilde;o&nbsp;<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">c&aacute;rie e acidentes</span>.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt6hv65":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:rgb(199, 199, 199); font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Lentes de Contato e Facetas Est&eacute;ticas</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt6hv8":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-family:madefor-text, helveticaneuew01-45ligh, helveticaneuew02-45ligh, helveticaneuew10-45ligh, sans-serif; font-size:18px;\" class=\"wixui-rich-text__text\">S&atilde;o procedimentos realizados, principalmente nos dentes anteriores, afim de <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">devolver a est&eacute;tica</span>&nbsp;e manter a fun&ccedil;&atilde;o correta entre eles. </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-family:madefor-text, helveticaneuew01-45ligh, helveticaneuew02-45ligh, helveticaneuew10-45ligh, sans-serif; font-size:18px;\" class=\"wixui-rich-text__text\">&Eacute; indicado para quem tem essas necessidades e desejam um <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">sorriso mais harm&ocirc;nico</span>, com <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">forma e cor</span> corrigidas. </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-family:madefor-text, helveticaneuew01-45ligh, helveticaneuew02-45ligh, helveticaneuew10-45ligh, sans-serif; font-size:18px;\" class=\"wixui-rich-text__text\">Podem ser realizadas com <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">resina ou laminados cer&acirc;micos (porcelana)</span>, precisando de desgastes ou n&atilde;o. Cada caso &eacute; planejado individualmente.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt7lli2":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Ortodontia - Ortopedia</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt7llj3":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Visa a <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">corre&ccedil;&atilde;o do alinhamento, mordida e fun&ccedil;&atilde;o</span> dos dentes. Podemos fazer isso atrav&eacute;s de diversos tipos de aparelhos: <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">fixo convencional, autoligado, est&eacute;tico ou Invisalign</span>. </span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:center; font-size:15px;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif; font-size:18px;\" class=\"wixui-rich-text__text\">Em crian&ccedil;as, trabalhamos na corre&ccedil;&atilde;o das bases &oacute;sseas atrav&eacute;s dos <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">aparelhos m&oacute;veis</span>, confeccionados de acordo com a necessidade de cada caso.</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt8cxl":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"color:rgb(199, 199, 199); font-family:caudex,serif; font-style:normal; font-weight:700;\" class=\"wixui-rich-text__text\">Cirurgias</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kt8cxm1":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">As cirurgias orais menores, s&atilde;o avaliadas e indicadas para aqueles que por algum motivo necessitam <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">extrair um ou mais dentes</span>, sejam os sisos ou qualquer outro. </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Quando necess&aacute;rio,<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"> reabilitamos com implantes ou pr&oacute;teses</span> posteriormente.</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hvire2":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:1.2em; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\">Contato</span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hvirdt":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Office Tower - Sala 304 (3&ordm; andar)</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Av. Tr&ecirc;s - Jardim Claret, Rio Claro - SP, 13503-251</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hvkhdw":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><a href=\"https://www.instagram.com/larafavrin/\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">@larafavrin</span></span></span></a></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hvmfs7":{"images":[{"alt":"Instagram   ","width":201,"height"