pType":"wysiwyg.viewer.components.SiteButton","language":"en","mainPageId":"c1dmp","compId":"comp-l7ku4o36","trackClicksAnalytics":false},"comp-l7ku4l0q":{"label":"Cirurgias","skin":"ShinyButtonISkin","link":{"href":"https://www.larafavrin.com/procedimentos","target":"_self","type":"PageLink","id":"dataItem-l9ihvoa4"},"hasPlatformClickHandler":false,"classNames":{"desktop":"desktop"},"a11y":{},"isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.SiteButton","language":"en","mainPageId":"c1dmp","compId":"comp-l7ku4l0q","trackClicksAnalytics":false},"comp-l7ku10no":{"label":"Botão","skin":"ShinyButtonISkin","link":null,"hasPlatformClickHandler":false,"classNames":{"desktop":"desktop"},"a11y":{},"isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.SiteButton","language":"en","mainPageId":"c1dmp","compId":"comp-l7ku10no","trackClicksAnalytics":false},"comp-l7huqyfz":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:1.2em; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\">Voc&ecirc; sabia...</span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7huqyg9":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Que pelo menos <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">a cada 6 meses</span>&nbsp;n&oacute;s precisamos realizar uma <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">profilaxia dent&aacute;ria</span> (a famosa limpeza nos dentes). </span></span></span><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Agende sua consulta e <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">aproveite para nos conhecer</span>! Assim analisamos sua sa&uacute;de bucal e aproveitamos para indicar os tratamentos mais apropriados para voc&ecirc;.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7krxuys":{"label":"Agendar","skin":"ShinyButtonISkin","link":{"href":"https://api.whatsapp.com/send?phone=5519981044440&text=Oii!%20Tudo%20bem%3F%20Vim%20pelo%20site!!%20Gostaria%20de%20agendar%20minha%20consulta.","target":"_blank","rel":"noreferrer noopener","type":"ExternalLink","id":"dataItem-l9ihwhbr"},"hasPlatformClickHandler":false,"classNames":{"desktop":"desktop"},"a11y":{},"isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.SiteButton","language":"en","mainPageId":"c1dmp","compId":"comp-l7krxuys","trackClicksAnalytics":false},"comp-ki4ly2y2":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:12px; line-height:1.1em; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:wfont_86135c_c9ca4a1db1064e619b219d38046ba0af,wf_c9ca4a1db1064e619b219d380,orig_quicksand_light;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"font-size:12px;\" class=\"wixui-rich-text__text\">Link direto para nosso WhatsApp</span></span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hv3yni":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal;\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\">As consultas</span></span></span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hv3ynq":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">As consultas s&atilde;o <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">previamente agendadas</span> nos hor&aacute;rios mais convenientes para todos e <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">confirmadas 1 dia antes</span>. </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Caso n&atilde;o seja poss&iacute;vel comparecer, avise-nos <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">com anteced&ecirc;ncia</span> para reagendarmos no hor&aacute;rio mais pr&oacute;ximo.&nbsp;</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Disponibilizamos um n&uacute;mero de <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">WhatsApp</span> que ficar&aacute; ativo em hor&aacute;rio comercial caso voc&ecirc; tenha d&uacute;vidas enquanto estiver em tratamento conosco.</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hwmtk0":{"label":"Agende sua Consulta","skin":"ShinyButtonISkin","link":{"href":"https://api.whatsapp.com/send?phone=5519981044440&text=Oii!%20Tudo%20bem%3F%20Vim%20pelo%20site!!%20Gostaria%20de%20agendar%20minha%20consulta.","target":"_blank","rel":"noreferrer noopener","type":"ExternalLink","id":"dataItem-l9ihwceh"},"hasPlatformClickHandler":false,"classNames":{"desktop":"desktop"},"a11y":{},"isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.SiteButton","language":"en","mainPageId":"c1dmp","compId":"comp-l7hwmtk0","trackClicksAnalytics":false},"comp-l7hvcdrb":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:1.2em; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\">Exames e radiografias</span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hvcdrj":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Caso seja necess&aacute;rio algum exame de imagem, como radiografias panor&acirc;micas, teleradiografia, tomografias ou escaneamento, os mesmos ser&atilde;o encaminhados para centros radiol&oacute;gicos especializados ap&oacute;s a nossa avalia&ccedil;&atilde;o no consult&oacute;rio para prosseguir com o tratamento adequado.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7krwddm":{"label":"Agende sua Consulta","skin":"ShinyButtonISkin","link":{"href":"https://api.whatsapp.com/send?phone=5519981044440&text=Oii!%20Tudo%20bem%3F%20Vim%20pelo%20site!!%20Gostaria%20de%20agendar%20minha%20consulta.","target":"_blank","rel":"noreferrer noopener","type":"ExternalLink","id":"dataItem-l9ihw8bs"},"hasPlatformClickHandler":false,"classNames":{"desktop":"desktop"},"a11y":{},"isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.SiteButton","language":"en","mainPageId":"c1dmp","compId":"comp-l7krwddm","trackClicksAnalytics":false},"comp-l7hvcdrt":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:12px; line-height:1.1em; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:wfont_86135c_c9ca4a1db1064e619b219d38046ba0af,wf_c9ca4a1db1064e619b219d380,orig_quicksand_light;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"font-size:12px;\" class=\"wixui-rich-text__text\">Link direto para nosso WhatsApp</span></span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7z04ppw":{"uri":"86135c_a0fbb3b296c348da9d95273868e5f2b1~mv2.jpg","alt":"LaraFarvin-6.JPG","width":3333,"height":5000,"name":"LaraFarvin-6.JPG","containerId":"comp-l7z04ppw","ha