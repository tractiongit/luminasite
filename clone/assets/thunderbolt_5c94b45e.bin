"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span class=\"color_13 wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\">Sobre n&oacute;s</span></span></span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-keim9yij":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Somos uma <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">equipe multidisciplinar</span>&nbsp;que visa oferecer uma experi&ecirc;ncia odontol&oacute;gica completa e de<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">&nbsp;excel&ecirc;ncia</span>. </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Usamos os <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">melhores materiais</span> oferecidos pelo mercado e buscamos oferecer o m&aacute;ximo de&nbsp;<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">conforto durante os procedimentos</span>. Desde a chegada, durante e ap&oacute;s o tratamento queremos proporcionar a voc&ecirc; a melhor experi&ecirc;ncia. </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Cada procedimento &eacute; realizado por um</span></span><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"> profissional especialista na &aacute;rea</span></span></span><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">. E caso necess&aacute;rio, j</span></span><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">unto de cada cirurgi&atilde;o-dentista, ter&aacute; uma auxiliar para facilitar ainda mais o atendimento.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">O consult&oacute;rio disponibiliza todos os equipamentos devidamente limpos e <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">esterilizados</span>, assim como todo EPI (equipamento de prote&ccedil;&atilde;o individual) para a sua e a nossa biosseguran&ccedil;a.</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l80fd476":{"uri":"86135c_10470702e1174074852f9a4c5c5ac2c4~mv2.jpg","alt":"LaraFarvin-8_edited_edited_edited.jpg","width":2000,"height":832,"name":"LaraFarvin-8_edited_edited_edited.jpg","containerId":"comp-l80fd476","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"crop":{"x":582,"y":0,"width":836,"height":832,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/86135c_10470702e1174074852f9a4c5c5ac2c4~mv2.jpg/v1/crop/x_582,y_0,w_836,h_832/fill/w_197,h_196,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LaraFarvin-8_edited_edited_edited.jpg","srcset":"https://static.wixstatic.com/media/86135c_10470702e1174074852f9a4c5c5ac2c4~mv2.jpg/v1/crop/x_582,y_0,w_836,h_832/fill/w_197,h_196,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LaraFarvin-8_edited_edited_edited.jpg 1x, https://static.wixstatic.com/media/86135c_10470702e1174074852f9a4c5c5ac2c4~mv2.jpg/v1/crop/x_582,y_0,w_836,h_832/fill/w_394,h_392,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/LaraFarvin-8_edited_edited_edited.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":197,"height":196,"objectFit":"cover"}}},"containerWidth":197,"containerHeight":196,"isInFirstFold":false,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-l80fd476","mainPageId":"c1dmp","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-l7auu4wc":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\">Lara Favrin</span></span></span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7auw3un":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Formada pela Unesp Araraquara (2013), especialista em Ortodontia e Ortopedia funcional dos maxilares e Invisalign doctor.&nbsp;<br class=\"wixui-rich-text__text\">\nParticipo de diversos cursos, congressos e palestras e atrav&eacute;s de muito estudo e conhecimento, busco promover a melhora da qualidade de vida dos meus pacientes.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l80fda08":{"uri":"86135c_5ee9c01818224324a17caf31271563fc~mv2.jpg","alt":"fda1d95d-13b3-49b2-a9e4-e6ca277c6b60.jpg","width":1200,"height":1600,"name":"fda1d95d-13b3-49b2-a9e4-e6ca277c6b60.jpg","containerId":"comp-l80fda08","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"crop":{"x":47,"y":35,"width":1153,"height":1149,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/86135c_5