-l80fddk0","mainPageId":"c1dmp","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-l7av0vmz":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\">Dr. Fernando Gorla</span></span></span></span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7av0vnc":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Formado pela Unesp Araraquara, especialista em CTBMF pela Unesp Araraquara. Pesquisador de doutorado do departamento de diagn&oacute;stico e cirurgia da UNESP. Colaborador no servi&ccedil;o de resid&ecirc;ncia em CTBMF da Unesp.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hw20572":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:40px; line-height:1.2em; text-align:center;\"><span style=\"color:rgb(255, 255, 255); font-family:caudex,serif; font-style:normal;\" class=\"wixui-rich-text__text\">Recebemos voc&ecirc; com toda comodidade e seguran&ccedil;a</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7hw20582":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:madefor-text,helveticaneuew01-45ligh,helveticaneuew02-45ligh,helveticaneuew10-45ligh,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Contamos com confort&aacute;vel recep&ccedil;&atilde;o, &aacute;rea de caf&eacute; e pontos de &aacute;lcool em gel para voc&ecirc; aguardar sua consulta com todo conforto e seguran&ccedil;a.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l7kry5uv":{"label":"Agendar","skin":"ShinyButtonISkin","link":{"href":"https://api.whatsapp.com/send?phone=5519981044440&text=Oii!%20Tudo%20bem%3F%20Vim%20pelo%20site!!%20Gostaria%20de%20agendar%20minha%20consulta.","target":"_blank","rel":"noreferrer noopener","type":"ExternalLink","id":"dataItem-l9ihwlnd"},"hasPlatformClickHandler":false,"classNames":{"desktop":"desktop"},"a11y":{},"isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.SiteButton","language":"en","mainPageId":"c1dmp","compId":"comp-l7kry5uv","trackClicksAnalytics":false},"comp-l7hw20591":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:12px; line-height:1.1em; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-family:wfont_86135c_c9ca4a1db1064e619b219d38046ba0af,wf_c9ca4a1db1064e619b219d380,orig_quicksand_light;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"font-size:12px;\" class=\"wixui-rich-text__text\">Link direto para nosso WhatsApp</span></span></span></span></p>","skin":"WRichTextNewSkin","isQaM